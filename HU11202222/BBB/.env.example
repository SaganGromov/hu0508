# Copy to .env only if you want to avoid passing CLI flags.
# Do not put real credentials here; keep using the JSON credentials file.

DB2_JDBC_URL=jdbc:db2://b2db2g5.plexbs2.bb.com.br:61250/B2DB2G5
DB2_CREDENTIALS_FILE=../gravar_dados_vpn/db2_credentials.json

# Historical VPN table. Defaults are based on the local VPN table notes.
DB2_SCHEMA=DB2PEP
DB2_TABLE=AUT_CPTV

# Column names are configurable because the local documents mention more than
# one physical naming convention for the same VPN dataset.
VPN_USER_COLUMN=CD_USU_AUT
VPN_TIMESTAMP_COLUMN=TS_TRAN
VPN_SOURCE_IP_COLUMN=CD_END_LGC_OGM
VPN_CORPORATE_IP_COLUMN=CD_END_LGC_CPTV
VPN_HOSTNAME_COLUMN=NM_DSVO
VPN_DEVICE_COLUMN=CD_IDFC_DSVO

# Optional table for the "VPN active + physical BB login" policy.
# If omitted, this rule is reported as skipped while the other cases still run.
# PHYSICAL_SCHEMA=DB2PEP
# PHYSICAL_TABLE=LOGIN_FISICO
# PHYSICAL_USER_COLUMN=CD_USU
# PHYSICAL_TIMESTAMP_COLUMN=TS_TRAN
# PHYSICAL_NETWORK_COLUMN=TIPO_REDE
# PHYSICAL_NETWORK_VALUE=FISICA_BB
