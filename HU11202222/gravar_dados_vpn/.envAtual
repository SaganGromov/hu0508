# DESENV
PAYLOAD_LOG_FILE=/var/log/PAYLOADS.log
KAFKA_BOOTSTRAP_SERVERS=acr-kafka-seguranca-bb1-broker-3.desenv.bb.com.br:443
REDIS_SENTINELS=10.246.11.141:26379,10.246.10.107:26379,10.246.11.150:26379
REDIS_MASTER_NAME=mymaster
REDIS_USERNAME=
REDIS_MASTER_USERNAME=
REDIS_PASSWORD=dqGzdado
REDIS_SENTINEL_PASSWORD=
SESSION_TTL_SECONDS=86400
SESSION_TTL_SLACK=900
LOG_FILE=/var/log/redis_writer.log

# DB2 Writer (vpn_data_writer.py)
DB2_HOSTNAME=brdb2p1.plexbsb.bb.com.br
DB2_PORT=446
DB2_DATABASE=BRDB2P1
DB2_SCHEMA=DB2PEP
DB2_TABLE=AUT_CPTV
DB2_CREDENTIALS_FILE=./db2_credentials.json
POLL_INTERVAL_SECONDS=5
VPN_WRITER_LOG_FILE=/var/log/vpn_data_writer.log
DB2_CURSOR_KEY=PEP:db2writer:last_score

